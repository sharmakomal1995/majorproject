<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wanderlust</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
    integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link href="/css/rating.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX41XOF2J2hA1N7f1p6NOw=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/wishlist.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/show.css">
  <link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet">
</head>

<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
    <%- include("../includes/navbar.ejs") %>
        <div class="container"><%- include("../includes/flash.ejs") %><%- body %></div>
        <% if (typeof footerTop !=="undefined" && footerTop) { %>
          <%- include("../includes/footer") %>
            <% } %>

              <% if(currentPath==="/listings" ) { %>

                <div class="mobile-bottom-nav">

                  <a href="/listings" class="nav-item">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span>Explore</span>
                  </a>

                  <a href="/wishlist" class="nav-item">
                    <i class="fa-regular fa-heart"></i>
                    <span>Wishlists</span>
                  </a>

                  <a href="/profile/past-trips" class="nav-item">
                    <i class="fa-brands fa-airbnb"></i>
                    <span>Trips</span>
                  </a>

                  <a href="/messages/inbox" class="nav-item">
                    <i class="fa-regular fa-comment"></i>
                    <span>Messages</span>
                  </a>

                  <% if (currUser) { %>
                    <a href="/profile" class="nav-item">

                      <% if (currUser.profileImage && currUser.profileImage.url) { %>
                        <img src="<%= currUser.profileImage.url %>" alt="Profile" class="nav-profile-pic">
                        <% } else { %>
                          <span class="profile-letter">
                            <%= currUser.username.charAt(0).toUpperCase() %>
                          </span>
                          <% } %>

                            <span>Profile</span>
                    </a>
                    <% } %>

                </div>

                <% } %>
                  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                    crossorigin="anonymous"></script>
                  <script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>
                  <script src="/js/map.js" defer></script>
                  <script src="/js/script.js" defer></script>
                  <script src="/js/search.js" defer></script>
                  <script src="/js/feedback.js" defer></script>
                  <script src="/js/wishlist.js"></script>

</body>

</html>