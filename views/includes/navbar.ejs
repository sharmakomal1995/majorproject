<style>
  .airbnb-search {
    background: white;
    border-radius: 50px;
    padding: 8px 10px;
    gap: 10px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .search-box {
    display: flex;
    flex-direction: column;
    padding: 0 18px;
    cursor: pointer;
  }

  .search-box .title {
    font-size: 12px;
    font-weight: 600;
    color: #000;
  }

  .search-box .sub {
    font-size: 14px;
    color: #717171;
  }

  .divider {
    width: 1px;
    height: 32px;
    background: #ddd;
  }

  .search-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: #ff385c;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .airbnb-logo {
    height: 32px;
    width: auto;
    margin-right: 6px;
  }

  .brand-text {
    font-size: 1.6rem;
    font-weight: 700;
    color: #ff385c;
  }

  .navbar-brand,
  .navbar-brand:hover,
  .navbar-brand:focus {
    color: #ff385c !important;
    text-decoration: none;
  }

  .nav-link {
    color: #222;
    font-weight: 500;
  }

  .nav-link:hover {
    background-color: #f7f7f7;
    border-radius: 999px;
  }

  .airbnb-home {
    font-weight: 500;
    color: #222;
  }

  .airbnb-home:hover {
    background-color: #f7f7f7;
    border-radius: 999px;
  }

  .user-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #222;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    text-transform: uppercase;
    overflow: hidden;
    cursor: pointer;
  }

  .user-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu-btn {
    background: rgb(240, 233, 233);
    border: 1px solid #fff;
    border-radius: 999px;
    padding: 8px 12px;
  }

  .menu-btn i {
    font-size: 16px;
    color: #222;
  }

  .menu-btn:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    background: rgb(240, 233, 233);
  }

  .dropdown-toggle::after {
    display: none !important;
  }

  .navbar-toggler,
  .dropdown-toggle {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .navbar-toggler-icon {
    width: 20px;
    height: 20px;
  }


  .where-box {
    position: relative;
  }

  .where-input {
    border: none;
    outline: none;
    font-size: 14px;
    margin-top: 2px;
    cursor: pointer;
  }

  .where-dropdown {
    position: absolute;
    top: 60px;
    left: 0;
    width: 280px;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    display: none;
    z-index: 1000;
  }

  .where-option:hover {
    background: #f7f7f7;
  }

  #whenInput {
    border: none;
    outline: none;
    background: transparent;
    box-shadow: none;
    font-size: 14px;
    margin-top: 2px;
    cursor: pointer;
  }

  #whenBox {
    position: relative;
  }

  #whenBox .label {
    font-size: 12px;
    font-weight: 600;
    color: #222;
  }

  .calender-dropdown {
    display: none;
    position: absolute;
    top: 60px;
    left: 0;
    background: white;
    padding: 20px;
    width: 320px;
    border-radius: 14px;
    box-sizing: border-box;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    z-index: 1000;
  }

  .date-row {
    display: flex;
    gap: 12px;
  }

  .date-field {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .date-label {
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 4px;
    color: #222;
  }

  .date-field input {
    height: 36px;
    font-size: 13px;
    padding: 4px 6px;
  }


  #whoInput {
    border: none;
    outline: none;
    background: transparent;
    box-shadow: none;
    font-size: 14px;
    margin-top: 2px;
    cursor: pointer;
  }

  #whoBox {
    position: relative;
  }

  .guest-dropdown {
    display: none;
    position: absolute;
    top: 60px;
    left: 0;
    background: #fff;
    padding: 20px;
    width: 320px;
    border-radius: 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    z-index: 1000;
  }

  .guest-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
  }

  .counter button {
    width: 30px;
    height: 30px;
    border-radius: 50%;
  }

@media (max-width: 768px) {

  /* Hide other navbar items */
  .navbar-brand,
  .nav-link,
  .dropdown,
  .menu-btn,
  .user-avatar,
  .navbar-toggler {
    display: none !important;
  }

  body {
    overflow-x: hidden;
  }

  .navbar-collapse {
    display: flex !important;
    justify-content: center;
  }

  #mainNavbar .container-fluid {
    padding: 6px 8px !important;
    justify-content: center !important;
  }

  /* Search bar wrapper */
   .airbnb-search {
    width: calc(100vw - 16px);  
    max-width: 100%;
    padding: 4px 6px;
    border-radius: 30px;
    display: flex;
    align-items: center;
    gap: 4px;
    box-sizing: border-box;
  }

  /* Equal width boxes */
  .search-box {
  flex: 1 1 0;
  min-width: 0;
  padding: 0 4px;
}

  /* Remove divider */
  .divider {
    display: none;
  }

  /* Smaller text */
  .search-box .title,
  #whenBox .label {
    font-size: 9px;
    line-height: 1;
  }

  .where-input,
  #whenInput,
  #whoInput {
    font-size: 11px;
    width: 100%;
  }

  /* Smaller search button */
  .search-circle {
  width: 22px;
  height: 22px;
  flex: 0 0 22px;  
  padding: 0;
}

}
</style>

<nav id="mainNavbar" class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="navbar-brand d-flex align-items-center" href="/listings">
          <img src="/images/airbnb-logo.png" alt="Airbnb Logo" class="airbnb-logo">
          <span class="brand-text">Airbnb</span>
        </a>
      </div>

      <div class="navbar-nav ms-auto">
        <form class="airbnb-search d-flex align-items-center" action="/listings/search" method="GET">
          <div class="search-box where-box" id="whereBox">
            <span class="title">Where</span>
            <input type="text" id="whereInput" class="where-input" placeholder="Search destinations"
              autocomplete="off" />
            <input type="hidden" name="location" id="locationField">
            <input type="hidden" name="checkin" id="checkinField">
            <input type="hidden" name="checkout" id="checkoutField">
            <input type="hidden" name="guests" id="guestsField">
            <div class="where-dropdown" id="whereDropdown">
              <div class="where-option">Delhi</div>
              <div class="where-option">Mumbai</div>
              <div class="where-option">Kolkata</div>
              <div class="where-option">Shimla</div>
              <div class="where-option">Himachal Pradesh</div>
              <div class="where-option">Dhaman</div>
              <div class="where-option">Masoori</div>
              <div class="where-option">Lonawala</div>
              <div class="where-option">Varanashi</div>
              <div class="where-option">Kashmir</div>
            </div>
          </div>
          <div class="divider"></div>
          <div class="search-box" id="whenBox">
            <span class="label">When</span>
            <input type="text" id="whenInput" placeholder="Add dates" readonly />
            <div class="calender-dropdown" id="whenDropdown">
              <div class="date-row">

                <div class="date-field">
                  <span class="date-label">Start date</span>
                  <input type="date" id="checkIn">
                </div>

                <div class="date-field">
                  <span class="date-label">End date</span>
                  <input type="date" id="checkOut">
                </div>

              </div>
            </div>
          </div>
          <div class="divider"></div>
          <div class="search-box" id="whoBox">
            <span class="title">Who</span>
            <input type="text" id="whoInput" placeholder="Add guests" readonly />
            <div id="whoDropdown" class="guest-dropdown">
              <div class="guest-row">
                <div>
                  <strong>Adults</strong>
                  <p>Ages 13 or above</p>
                </div>
                <div class="counter">
                  <button type="button" class="minus" data-type="adults">-</button>
                  <span id="adultsCount">0</span>
                  <button type="button" class="plus" data-type="adults">+</button>
                </div>
              </div>
              <div class="guest-row">
                <div>
                  <strong>Children</strong>
                  <p>Ages 2-12</p>
                </div>
                <div class="counter">
                  <button type="button" class="minus" data-type="children">-</button>
                  <span id="childrenCount">0</span>
                  <button type="button" class="plus" data-type="children">+</button>
                </div>
              </div>
              <div class="guest-row">
                <div>
                  <strong>Infants</strong>
                  <p>Under 2</p>
                </div>
                <div class="counter">
                  <button type="button" class="minus" data-type="infants">-</button>
                  <span id="infantsCount">0</span>
                  <button type="button" class="plus" data-type="infants">+</button>
                </div>
              </div>
              <div class="guest-row">
                <div>
                  <strong>Pets</strong>
                </div>
                <div class="counter">
                  <button type="button" class="minus" data-type="pets">-</button>
                  <span id="petsCount">0</span>
                  <button type="button" class="plus" data-type="pets">+</button>
                </div>
              </div>
            </div>
          </div>
          <button class="search-circle" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </form>
      </div>

      <div class="navbar-nav ms-auto align-items-center gap-3">
        <a class="nav-link" href="/listings/new">Airbnb your home</a>

        <% if (currUser) { %>
          <a href="/profile" class="user-avatar">
            <% if (currUser.profileImage && currUser.profileImage.url) { %>
              <img src="<%= currUser.profileImage.url %>" alt="Profile" class="nav-profile-pic">
              <% } else { %>
                <span>
                  <%= currUser.username.charAt(0).toUpperCase() %>
                </span>
                <% } %>
          </a>
          <% } %>

            <div class="dropdown">
              <button class="btn menu-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
                aria-expanded="false">
                <i class="fa-solid fa-bars"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <% if (currUser) { %>
                  <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" href="/wishlist">
                      <i class="fa-solid fa-heart text-danger"></i>
                      <span>My Wishlist</span>
                    </a>
                  </li>
                  <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" href="/bookings/my-bookings">
                      <i class="fa-solid fa-calendar-check"></i>
                      <span>My Bookings</span>
                    </a>
                  </li>
                  <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" href="/support/admin/support">
                      <i class="fa-solid fa-envelope"></i>
                      <span>Admin Inbox</span>
                    </a>
                  </li>
                  <a class="dropdown-item d-flex align-items-center gap-2" href="/messages/inbox">
                    <i class="fa-solid fa-envelope"></i>
                    <span>Your Message</span>
                  </a>
                  <% } %>

                    <% if (typeof currUser==="undefined" || !currUser) { %>

                      <li><a class="dropdown-item" href="/signup">Sign up</a></li>
                      <li><a class="dropdown-item" href="/login">Log in</a></li>
                      <% } %>

                        <% if (currUser) { %>
                          <li><a class="dropdown-item" href="/logout">Log out</a></li>
                          <% } %>
              </ul>
            </div>
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {

    /* ================= WHERE ================= */
    const whereInput = document.getElementById("whereInput");
    const locationField = document.getElementById("locationField");
    const whereDropdown = document.getElementById("whereDropdown");

    document.querySelectorAll(".where-option").forEach(option => {
      option.addEventListener("click", (e) => {
        e.stopPropagation();
        whereInput.value = option.innerText;
        locationField.value = option.innerText;
        whereDropdown.style.display = "none";
      });
    });

    whereInput.addEventListener("input", () => {
      locationField.value = whereInput.value;
    });

    whereDropdown.addEventListener("click", e => e.stopPropagation());


    /* ================= WHEN ================= */
    const checkIn = document.getElementById("checkIn");
    const checkOut = document.getElementById("checkOut");
    const whenInput = document.getElementById("whenInput");
    const whenDropdown = document.getElementById("whenDropdown");

    function updateDates() {
      if (checkIn.value && checkOut.value) {
        whenInput.value = checkIn.value + " → " + checkOut.value;

        document.getElementById("checkinField").value = checkIn.value;
        document.getElementById("checkoutField").value = checkOut.value;

        whenDropdown.style.display = "none";
      }
    }

    checkIn.addEventListener("change", updateDates);
    checkOut.addEventListener("change", updateDates);
    whenDropdown.addEventListener("click", e => e.stopPropagation());


    const whoDropdown = document.getElementById("whoDropdown");
    const whoInput = document.getElementById("whoInput");
    const guestsField = document.getElementById("guestsField");

    function updateGuests() {
      const adults = +document.getElementById("adultsCount").innerText;
      const children = +document.getElementById("childrenCount").innerText;
      const total = adults + children;

      whoInput.value = total > 0 ? total + " guests" : "Add guests";
      guestsField.value = total;
    }

    document.querySelectorAll(".plus, .minus").forEach(btn => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation(); 

        const type = btn.dataset.type;
        const span = document.getElementById(type + "Count");
        let count = +span.innerText;

        if (btn.classList.contains("plus")) count++;
        if (btn.classList.contains("minus") && count > 0) count--;

        span.innerText = count;
        updateGuests();
      });
    });

    whoDropdown.addEventListener("click", (e) => {
      e.stopPropagation();
    });

  });
  /* ================= OUTSIDE CLICK (GLOBAL CLOSE) ================= */
  document.addEventListener("click", () => {
    whereDropdown.style.display = "none";
    whenDropdown.style.display = "none";
    whoDropdown.style.display = "none";
  });
</script>


<script>
  // ===== OPEN DROPDOWNS =====

  const whereBox = document.getElementById("whereBox");
  const whereDropdown = document.getElementById("whereDropdown");

  const whenBox = document.getElementById("whenBox");
  const whenDropdown = document.getElementById("whenDropdown");

  const whoBox = document.getElementById("whoBox");
  const whoDropdown = document.getElementById("whoDropdown");

  whereBox.addEventListener("click", (e) => {
    e.stopPropagation();
    whereDropdown.style.display = "block";
  });

  whenBox.addEventListener("click", (e) => {
    e.stopPropagation();
    whenDropdown.style.display = "block";
  });

  whoBox.addEventListener("click", (e) => {
    e.stopPropagation();
    whoDropdown.style.display = "block";
  });

  // ===== CLOSE ON OUTSIDE CLICK =====
  document.addEventListener("click", () => {
    whereDropdown.style.display = "none";
    whenDropdown.style.display = "none";
    whoDropdown.style.display = "none";
  });
</script>