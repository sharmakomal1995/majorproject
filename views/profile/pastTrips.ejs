<style>
   body {
      background: #f7f7f7 !important;
      font-family: system-ui, -apple-system, sans-serif;
   }

   .profile-layout {
      display: flex;
   }

   /* sidebar */
   .profile-sidebar {
      width: 260px;
   }

   /* content */
   .profile-content {
      flex: 1;
      padding: 40px 60px;
   }

   .profile-content h2 {
      font-size: 28px;
      margin-bottom: 10px;
   }

   /* grid */
   .trip-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 24px;
      margin-top: 25px;
   }

   /* card */
   .trip-card {
      background: white;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
      transition: .25s ease;
      border: 1px solid #eee;
   }

   .trip-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.15);
   }

   /* image */
   .trip-img {
      width: 100%;
      height: 190px;
      object-fit: cover;
   }

   /* card body */
   .trip-body {
      padding: 18px;
   }

   .trip-title {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 6px;
   }

   .trip-date {
      font-size: 14px;
      color: #666;
      margin-bottom: 10px;
   }

   /* badge */
   .status {
      display: inline-block;
      font-size: 12px;
      padding: 4px 10px;
      border-radius: 999px;
      background: #e6f7ee;
      color: #16a34a;
      font-weight: 600;
   }

   /* empty state */
   .empty-state {
      text-align: center;
      margin-top: 80px;
   }

   .empty-state img {
      opacity: .7;
      margin-bottom: 15px;
   }

   .empty-state p {
      font-size: 18px;
      color: #777;
   }
</style>

<div class="profile-layout">

   <!-- Content -->
   <div class="profile-content">

      <h2>Past Trips</h2>

      <% if(pastTrips.length===0){ %>

         <div class="empty-state">
            <img src="/images/trips.png" class="empty-img">

            <h3>No trips booked... yet!</h3>

            <p>
               Time to explore 🌍<br>
               Start planning your next adventure.
            </p>

            <a href="/listings" class="explore-btn">Start searching</a>
         </div>

         <% } else { %>

            <div class="trip-grid">
               <% pastTrips.forEach(trip=> { %>

                  <div class="trip-card">

                     <img src="<%= trip.listing.images?.[0]?.url || '/images/default.jpg' %>" class="trip-img">

                     <div class="trip-body">

                        <div class="trip-title">
                           <%= trip.listing.title %>
                        </div>

                        <div class="trip-date">
                           <%= new Date(trip.checkIn).toDateString() %>
                              —
                              <%= new Date(trip.checkOut).toDateString() %>
                        </div>

                        <span class="status">
                           Completed
                        </span>

                     </div>

                  </div>

                  <% }) %>
            </div>

            <% } %>

   </div>
</div>