<style>
.profile-layout{
 display:flex;
}

.profile-sidebar{
 width:260px;
}

.profile-content{
 flex:1;
 padding:40px 60px;
}

.conn-grid{
 display:grid;
 grid-template-columns:repeat(auto-fill,minmax(260px,1fr));
 gap:20px;
 margin-top:25px;
}

.conn-card{
 background:white;
 border-radius:16px;
 padding:20px;
 text-align:center;
 box-shadow:0 6px 18px rgba(0,0,0,.08);
 transition:.25s;
}

.conn-card:hover{
 transform:translateY(-5px);
 box-shadow:0 12px 28px rgba(0,0,0,.15);
}

.conn-img{
 width:80px;
 height:80px;
 border-radius:50%;
 object-fit:cover;
 margin-bottom:12px;
}

.empty{
 text-align:center;
 margin-top:80px;
 color:#777;
}
</style>


<div class="profile-layout">


   <!-- CONTENT -->
   <div class="profile-content">

      <h2>Connections</h2>

      <% if(!connections || connections.length === 0){ %>

         <div class="empty">
            <p>No connections yet</p>
         </div>

      <% } else { %>

         <div class="conn-grid">

            <% connections.forEach(user => { %>

               <div class="conn-card">

                  <img 
                    src="<%= user.profileImage?.url || '/images/default-user.png' %>" 
                    class="conn-img"
                  >

                  <h4><%= user.username %></h4>

               </div>

            <% }) %>

         </div>

      <% } %>

   </div>
</div>